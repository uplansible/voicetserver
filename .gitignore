# Whitelist: ignore everything, then re-include only what belongs in the repo.
# New top-level files/dirs stay local until explicitly listed here.
/*

# Top-level files
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/TASKS.md
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/schmidispeech.user.js

# Directories tracked as a whole
!/.cargo/
!/assets/
!/candle-fork/
!/config/
!/qwen3-asr-rs/
!/scripts/
!/src/
!/tools/

# docs/: per-file, so new notes stay local unless listed
!/docs/
/docs/*
!/docs/API.md
!/docs/dictation-recorder-plan.md
!/docs/ubuntu_dependencies.md
!/docs/unified_server_migration_plan.md
